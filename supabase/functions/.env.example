# Secrets des Edge Functions.
#
# Aucune de ces valeurs ne doit exister côté app iOS : un binaire est
# décompilable, toute clé qui y figure est publique. Copier en `.env` pour le
# développement local, et pousser en production avec :
#   supabase secrets set --env-file supabase/functions/.env

# --- Supabase (injectés automatiquement en production) ----------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Assistant paroles ------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Moteur audio -----------------------------------------------------------
# Adaptateur actif. Seul `replicate` est implémenté pour l'instant.
MUSIC_ENGINE=replicate

REPLICATE_API_TOKEN=
# Secret de signature des webhooks : GET https://api.replicate.com/v1/webhooks/default/secret
REPLICATE_WEBHOOK_SECRET=

# ⚠️ Le moteur musical n'est pas encore choisi (Lot 1 de la Phase 1) et le
# critère décisif est la LICENCE COMMERCIALE. Ne pas renseigner ici un modèle
# en CC-BY-NC (dont MusicGen) : ce serait un défaut juridique, pas technique.
REPLICATE_MUSIC_MODEL_VERSION=
# Demucs (htdemucs) — séparation en pistes, licence MIT.
REPLICATE_DEMUCS_MODEL_VERSION=

# --- Monétisation -----------------------------------------------------------
# Secret partagé du webhook RevenueCat (tableau de bord → Integrations → Webhooks).
# RevenueCat n'utilise pas de HMAC : il renvoie cette valeur en clair dans
# l'en-tête Authorization, d'où la comparaison à temps constant côté serveur.
REVENUECAT_WEBHOOK_SECRET=
